---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Surfcast', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'The Surfcast Journal', item: `${SITE_URL}/blog.html` },
    ],
  },
];
---
<BaseLayout
  title="The Surfcast Journal — Forecasting notes & spot guides"
  description="Plain-English guides to reading swell period, wind, tide and wave forecast models — practical notes from the team behind the Surfcast surf forecast app."
  canonicalPath="/blog.html"
  navActive="blog"
  jsonLd={jsonLd}
>
<style is:global>
  .page-head { padding: 64px 0 48px; position: relative; overflow: hidden; }
  .page-head::before { content:""; position:absolute; inset:0; z-index:0;
    background: radial-gradient(900px 460px at 12% -20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%); }
  .page-head .wrap { position: relative; z-index: 2; }
  .page-head h1 { font-size: clamp(40px, 6vw, 76px); letter-spacing: -.035em; margin: 20px 0 18px; }

  /* placeholder cover */
  .ph { position: relative; border-radius: var(--r-md); overflow: hidden; background: var(--bg-surface); border: 1px solid var(--border-subtle); }
  .ph::before { content:""; position:absolute; inset:0;
    background-image: repeating-linear-gradient(135deg, transparent 0 13px, rgba(255,255,255,.025) 13px 26px),
      radial-gradient(120% 120% at 0% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 55%),
      radial-gradient(120% 120% at 100% 100%, rgba(0,196,254,.14), transparent 55%); }
  .ph .lbl { position:absolute; left:14px; bottom:12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: var(--text-tertiary); z-index:2; }

  .cat { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-hi); }
  .post-meta { font-family: var(--font-mono); font-size: 12.5px; color: var(--text-tertiary); display:flex; gap:14px; align-items:center; }
  .post-meta .dot { width:3px; height:3px; border-radius:50%; background: var(--text-faint); }

  /* featured */
  .featured { display:grid; grid-template-columns: 1.15fr 1fr; gap: 44px; align-items: center;
    background: var(--bg-card); border:1px solid var(--border-subtle); border-radius: var(--r-xl); padding: 22px;
    transition: border-color .2s ease; }
  .featured:hover { border-color: var(--border-default); }
  .featured .ph { aspect-ratio: 16/11; }
  .featured .body { padding: 14px 24px 14px 8px; }
  .featured h2 { font-size: clamp(26px, 3vw, 38px); letter-spacing: -.025em; margin: 16px 0 14px; line-height: 1.08; }
  .featured p { color: var(--text-secondary); font-size: 17px; margin-bottom: 22px; max-width: 44ch; }

  @media (max-width: 880px) {
    .featured { grid-template-columns: 1fr; }
    .featured .ph { aspect-ratio: 16/9; }
  }
</style>

<header class="page-head">
  <div class="wrap">
    <span class="eyebrow">The Surfcast Journal</span>
    <h1>Notes from<br />the line-up.</h1>
    <p class="lede">Plain-English guides to reading swell, wind, tide and forecast models — so the numbers in the app always mean something.</p>
  </div>
</header>

<main class="wrap" style="padding-bottom: 100px">

  <article class="featured">
    <a class="ph" href="article.html" style="display:block" aria-hidden="true" tabindex="-1"><span class="lbl">COVER · 1600×1100</span></a>
    <div class="body">
      <span class="cat">Forecasting</span>
      <h2><a href="article.html">Swell period: the number that decides your session.</a></h2>
      <p>Two-foot at 6 seconds and two-foot at 16 seconds are not the same wave. Here's why period — not height — is the first thing to read on any forecast.</p>
      <div class="post-meta"><span>8 min read</span><span class="dot"></span><time datetime="2026-05-28">May 28, 2026</time></div>
    </div>
  </article>

</main>
</BaseLayout>
