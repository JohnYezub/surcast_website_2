---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Terms of Use — Surfcast"
  description="The terms that govern your use of the Surfcast app and surfcastapp.com."
  footerActive="terms"
>
<header class="legal-head">
  <div class="wrap">
    <span class="eyebrow">Legal</span>
    <h1>Terms of Use</h1>
    <p class="updated">Last updated · May 1, 2026</p>
    <p class="intro">These terms govern your use of the Surfcast mobile application and surfcastapp.com. By downloading, accessing or using Surfcast, you agree to them.</p>
  </div>
</header>

<div class="wrap">
  <div class="legal-grid">

    <aside class="toc">
      <div class="t">On this page</div>
      <ol>
        <li><a href="#acceptance">Acceptance of terms</a></li>
        <li><a href="#service">The service</a></li>
        <li><a href="#forecast">Forecast data &amp; safety</a></li>
        <li><a href="#use">Acceptable use</a></li>
        <li><a href="#ip">Intellectual property</a></li>
        <li><a href="#thirdparty">Third-party data</a></li>
        <li><a href="#disclaimer">Disclaimer of warranties</a></li>
        <li><a href="#liability">Limitation of liability</a></li>
        <li><a href="#changes">Changes to these terms</a></li>
        <li><a href="#contact">Contact</a></li>
