---
import { APPSTORE_URL } from '../consts';

interface Props {
  /** On the homepage the links are same-page hashes / App Store; on subpages
   *  they point back to index.html. */
  home?: boolean;
  /** Highlights a legal link: "privacy" or "terms". */
  active?: string;
}
const { home = false, active } = Astro.props;
const prefix = home ? '' : 'index.html';
const download = home ? APPSTORE_URL : 'index.html#download';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="index.html">
          <svg class="mark" viewBox="0 0 100 100"><use href="#sunset" /></svg>
          <span class="name">Surfcast</span>
        </a>
        <p class="blurb">Surf forecasts you can actually read. Four models, live tide and swell, and your spots — in one calm app.</p>
      </div>
      <div>
        <h4>Product</h4>
        <div class="footer-links">
          <a href={`${prefix}#features`}>Features</a>
          <a href={`${prefix}#compare`}>Model comparison</a>
          <a href={`${prefix}#features`}>Widgets</a>
          <a href={download}>Download</a>
        </div>
      </div>
      <div>
        <h4>Resources</h4>
        <div class="footer-links">
          <a href="blog.html">Blog</a>
          <a href={`${prefix}#faq`}>FAQ</a>
          <a href="mailto:hello@surfcastapp.com">Support</a>
        </div>
      </div>
      <div>
        <h4>Legal</h4>
        <div class="footer-links">
          <a href="terms.html" style={active === 'terms' ? 'color:var(--text-primary)' : undefined}>Terms of Use</a>
          <a href="privacy.html" style={active === 'privacy' ? 'color:var(--text-primary)' : undefined}>Privacy Policy</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="mono">© 2026 SURFCAST · surfcastapp.com</span>
      <span class="mono">MADE FOR THE EARLY START</span>
    </div>
  </div>
</footer>
