---
// Hidden SVG defs holding the reusable "sunset" brand mark (referenced via
// <use href="#sunset" />). Rendered once per page by BaseLayout.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="sunGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFC074" /><stop offset="1" stop-color="#E07800" />
    </linearGradient>
    <clipPath id="sunClip"><circle cx="50" cy="53" r="33" /></clipPath>
    <clipPath id="rcClip"><rect width="100" height="100" rx="26" /></clipPath>
    <symbol id="sunset" viewBox="0 0 100 100">
      <g clip-path="url(#rcClip)">
        <rect width="100" height="100" fill="#0C1322" />
        <circle cx="50" cy="53" r="33" fill="url(#sunGrad)" />
        <g clip-path="url(#sunClip)">
          <rect x="0" y="60" width="100" height="40" fill="#0E7C72" />
          <rect x="0" y="62" width="100" height="3.4" fill="#F4FBFA" />
          <rect x="0" y="71" width="100" height="3.4" fill="#F4FBFA" />
          <rect x="0" y="80" width="100" height="3.4" fill="#F4FBFA" />
        </g>
      </g>
    </symbol>
  </defs>
</svg>
